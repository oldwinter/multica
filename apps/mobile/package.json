{
  "name": "@multica/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging expo start",
    "dev:prod": "dotenv -e .env.production -- cross-env APP_ENV=production expo start",
    "ios": "./scripts/ios-run.sh",
    "ios:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh",
    "ios:prod": "dotenv -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh",
    "ios:device": "./scripts/ios-run.sh --device",
    "ios:device:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh --device",
    "ios:device:staging:release": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh --device --configuration Release",
    "ios:device:prod": "dotenv -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh --device",
    "ios:device:prod:release": "dotenv -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh --device --configuration Release",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bash scripts/ios-run.test.sh"
  },
  "dependencies": {
    "@expo/dom-webview": "^57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
